// =============================================================================
// Motor-Force: категория номенклатуры = бренд из заказа Bitrix
//
// ПОЧЕМУ «Доставка» и почему старый патч не работал:
// 1) Тег <Категория> 1С не читает (нет в схеме CommerceML).
// 2) Бренд приходит в <ТорговаяМарка> и в <ЗначенияРеквизитов> как
//    «СвойствоКорзины#Категория» / «#MF_BRAND».
// 3) Процедура «Заполнить(Неопределено)» подставляет категорию по умолчанию
//    пользователя (часто «Доставка»). Патч — СТРОГО ПОСЛЕ Заполнить, ДО Записать.
// 4) Если код стоит ДО Заполнить или ПОСЛЕ Записать — в карточке останется «Доставка».
// 5) Функции MF_* и вставки — только в том же модуле, где НайтиСоздатьНоменклатуру
//    (нужны ОбъектXDTOСодержитСвойство, ПолучитьМассивОбъектовСпискаXDTO).
//
// КАКОЙ МОДУЛЬ ПРАВИТЬ:
// — УНФ 3.0, «Интеграция с интернет-магазином» (константа включена):
//   CommonModules.ИнтеграцияСИнтернетМагазиномСервер → НайтиСоздатьНоменклатуру (~стр. 229).
// — Старый обмен (план обмена «С сайтом», без новой интеграции):
//   CommonModules.ОбменССайтом → НайтиСоздатьНоменклатуру (~стр. 7573) — ЧАСТЬ 4.
// Проверка: НСИ → Константы → «Использовать интеграцию с интернет-магазином».
//
// ДИАГНОСТИКА (если снова «Доставка»):
// 1) Временно раскомментируйте Сообщить в MF_УстановитьКатегорию… — при загрузке заказа
//    должно быть: MF brand=[Mercury]. Пусто — 1С не видит XML (не тот обмен / старый XML).
// 2) Нет сообщения вообще — патч не в том модуле или БД не обновлена после правок.
// 3) brand=[Mercury], категория «Доставка» — код не между Заполнить и Записать.
// 4) Перед тестом: удалить номенклатуру И поиск по артикулу 896539T01 (дубликаты),
//    плюс ЧАСТЬ 2 — иначе ранний «Возврат» без обновления категории.
//
// УСТАНОВКА:
// A) Конец модуля ИнтеграцияСИнтернетМагазиномСервер — ЧАСТЬ 1.
// B) НайтиСоздатьНоменклатуру — ЧАСТЬ 2 (ранний возврат) и ЧАСТЬ 3 (новая номенклатура).
// C) При старом обмене — то же в ОбменССайтом — ЧАСТЬ 4.
// D) Конфигурация → Обновить конфигурацию базы данных → перезапуск сеанса 1С.
// =============================================================================


// ======================== ЧАСТЬ 1: конец модуля ========================

Функция MF_ПолучитьБрендИзТоварXDTO(ТоварXDTO) Экспорт

	НаименованиеКатегории = "";

	Если ТоварXDTO = Неопределено Тогда
		Возврат НаименованиеКатегории;
	КонецЕсли;

	// ТорговаяМарка — поле CommerceML (Bitrix добавляет при экспорте)
	Если ОбъектXDTOСодержитСвойство(ТоварXDTO, "ТорговаяМарка")
		И СвойствоXDTOЗаполнено(ТоварXDTO.ТорговаяМарка) Тогда
		НаименованиеКатегории = СокрЛП(ТоварXDTO.ТорговаяМарка);
	КонецЕсли;

	// Свойства корзины Bitrix
	Если Не ЗначениеЗаполнено(НаименованиеКатегории)
		И ОбъектXDTOСодержитСвойство(ТоварXDTO, "ЗначенияРеквизитов")
		И ТоварXDTO.ЗначенияРеквизитов <> Неопределено
		И ОбъектXDTOСодержитСвойство(ТоварXDTO.ЗначенияРеквизитов, "ЗначениеРеквизита") Тогда

		МассивРеквизитов = ПолучитьМассивОбъектовСпискаXDTO(ТоварXDTO.ЗначенияРеквизитов.ЗначениеРеквизита);

		Для Каждого ЗначениеРеквизитаXDTO Из МассивРеквизитов Цикл

			ИмяРеквизита = ЗначениеРеквизитаXDTO.Наименование;
			ЗначениеРеквизита = "";

			Если ТипЗнч(ЗначениеРеквизитаXDTO.Значение) = Тип("Строка") Тогда
				ЗначениеРеквизита = ЗначениеРеквизитаXDTO.Значение;
			ИначеЕсли ТипЗнч(ЗначениеРеквизитаXDTO.Значение) = Тип("СписокXDTO")
				И ЗначениеРеквизитаXDTO.Значение.Количество() > 0 Тогда
				ЗначениеРеквизита = ЗначениеРеквизитаXDTO.Значение[0];
			КонецЕсли;

			Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
				Продолжить;
			КонецЕсли;

			Если Лев(ИмяРеквизита, 16) = "СвойствоКорзины#" Тогда
				ИмяРеквизита = Сред(ИмяРеквизита, 17);
			КонецЕсли;

			Если ИмяРеквизита = "Категория"
				Или ИмяРеквизита = "MF_CATEGORY"
				Или ИмяРеквизита = "MF_BRAND"
				Или ИмяРеквизита = "CML2_MANUFACTURER" Тогда
				НаименованиеКатегории = СокрЛП(ЗначениеРеквизита);
				Прервать;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Возврат НаименованиеКатегории;

КонецФункции

Процедура MF_УстановитьКатегориюНоменклатурыПоБренду(Номенклатура, ТоварXDTO) Экспорт

	НаименованиеКатегории = MF_ПолучитьБрендИзТоварXDTO(ТоварXDTO);

	// Временно для отладки — раскомментируйте, загрузите заказ, смотрите «Сообщения» в 1С:
	// Сообщить("MF brand=[" + НаименованиеКатегории + "]");

	Если Не ЗначениеЗаполнено(НаименованиеКатегории) Тогда
		Возврат;
	КонецЕсли;

	Категория = Справочники.КатегорииНоменклатуры.НайтиПоНаименованию(НаименованиеКатегории, Истина);
	Если Не ЗначениеЗаполнено(Категория) Тогда
		КатегорияОбъект = Справочники.КатегорииНоменклатуры.СоздатьЭлемент();
		КатегорияОбъект.Наименование = НаименованиеКатегории;
		КатегорияОбъект.Записать();
		Категория = КатегорияОбъект.Ссылка;
	КонецЕсли;

	Если ТипЗнч(Номенклатура) = Тип("СправочникОбъект.Номенклатура") Тогда
		Номенклатура.КатегорияНоменклатуры = Категория;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
	Если НоменклатураОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НоменклатураОбъект.КатегорияНоменклатуры = Категория Тогда
		Возврат;
	КонецЕсли;

	НоменклатураОбъект.КатегорияНоменклатуры = Категория;
	НоменклатураОбъект.Записать();

КонецПроцедуры


// ======================== ЧАСТЬ 2: НайтиСоздатьНоменклатуру ========================
// Найти блок (примерно строка 275–279):
//
//   Номенклатура = НайтиНоменклатуруПоАртикулуНаименованию(...);
//   Если ЗначениеЗаполнено(Номенклатура) Тогда
//       Возврат Номенклатура;
//   КонецЕсли;
//
// ЗАМЕНИТЬ на:

	Номенклатура = НайтиНоменклатуруПоАртикулуНаименованию(АртикулНоменклатуры, НаименованиеНоменклатуры, Параметры.СоответствиеПолейНоменклатуры);

	Если ЗначениеЗаполнено(Номенклатура) Тогда
		MF_УстановитьКатегориюНоменклатурыПоБренду(Номенклатура, ТоварXDTO);
		Возврат Номенклатура;
	КонецЕсли;


// ======================== ЧАСТЬ 3: НайтиСоздатьНоменклатуру ========================
// ПОСЛЕ «Номенклатура.Заполнить(Неопределено);», ДО «Номенклатура.Записать();»:

	MF_УстановитьКатегориюНоменклатурыПоБренду(Номенклатура, ТоварXDTO);


// ======================== ПРОСТОЙ ВАРИАНТ (без функций MF_*) ========================
// Вставить ПОСЛЕ «Заполнить», ДО «Записать» — если не добавляли ЧАСТЬ 1.
// Удалите старый код с «ТоварXDTO.Категория» — он не работает!

	НаименованиеКатегории = "";
	Если ОбъектXDTOСодержитСвойство(ТоварXDTO, "ТорговаяМарка")
		И СвойствоXDTOЗаполнено(ТоварXDTO.ТорговаяМарка) Тогда
		НаименованиеКатегории = СокрЛП(ТоварXDTO.ТорговаяМарка);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НаименованиеКатегории)
		И ОбъектXDTOСодержитСвойство(ТоварXDTO, "ЗначенияРеквизитов")
		И ТоварXDTO.ЗначенияРеквизитов <> Неопределено
		И ОбъектXDTOСодержитСвойство(ТоварXDTO.ЗначенияРеквизитов, "ЗначениеРеквизита") Тогда
		МассивРеквизитов = ПолучитьМассивОбъектовСпискаXDTO(ТоварXDTO.ЗначенияРеквизитов.ЗначениеРеквизита);
		Для Каждого ЗначениеРеквизитаXDTO Из МассивРеквизитов Цикл
			ИмяРеквизита = ЗначениеРеквизитаXDTO.Наименование;
			ЗначениеРеквизита = "";
			Если ТипЗнч(ЗначениеРеквизитаXDTO.Значение) = Тип("Строка") Тогда
				ЗначениеРеквизита = ЗначениеРеквизитаXDTO.Значение;
			ИначеЕсли ТипЗнч(ЗначениеРеквизитаXDTO.Значение) = Тип("СписокXDTO")
				И ЗначениеРеквизитаXDTO.Значение.Количество() > 0 Тогда
				ЗначениеРеквизита = ЗначениеРеквизитаXDTO.Значение[0];
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
				Продолжить;
			КонецЕсли;
			Если Лев(ИмяРеквизита, 16) = "СвойствоКорзины#" Тогда
				ИмяРеквизита = Сред(ИмяРеквизита, 17);
			КонецЕсли;
			Если ИмяРеквизита = "Категория" Или ИмяРеквизита = "MF_CATEGORY"
				Или ИмяРеквизита = "MF_BRAND" Или ИмяРеквизита = "CML2_MANUFACTURER" Тогда
				НаименованиеКатегории = СокрЛП(ЗначениеРеквизита);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(НаименованиеКатегории) Тогда
		Категория = Справочники.КатегорииНоменклатуры.НайтиПоНаименованию(НаименованиеКатегории, Истина);
		Если Не ЗначениеЗаполнено(Категория) Тогда
			КатегорияОбъект = Справочники.КатегорииНоменклатуры.СоздатьЭлемент();
			КатегорияОбъект.Наименование = НаименованиеКатегории;
			КатегорияОбъект.Записать();
			Категория = КатегорияОбъект.Ссылка;
		КонецЕсли;
		Номенклатура.КатегорияНоменклатуры = Категория;
	КонецЕсли;


// ======================== ЧАСТЬ 4: ОбменССайтом (старый обмен) ========================
// Если заказы грузятся через план обмена / «Обмен с сайтом», правки в
// ИнтеграцияСИнтернетМагазиномСервер НЕ вызываются.
//
// 1) В КОНЕЦ модуля «ОбменССайтом» скопируйте ЧАСТЬ 1 (обе функции MF_*).
// 2) В ОбменССайтом.НайтиСоздатьНоменклатуру (~7573):
//    — ЧАСТЬ 2 вместо блока «Если ЗначениеЗаполнено(Номенклатура) Тогда Возврат»;
//    — ЧАСТЬ 3 ПОСЛЕ «Номенклатура.Заполнить(Неопределено);» (~7663),
//      ДО «Номенклатура.Записать();» (~7665).
//    В этом модуле между Заполнить и Записать нет строки про БЭД — порядок тот же.

